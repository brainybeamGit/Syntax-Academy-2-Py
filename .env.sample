DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_DB_PATH=db.sqlite3

# Email (console backend by default)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Razorpay (leave blank for demo)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Admin credentials removed from sample
# Set admin credentials in your local .env (do not commit secrets)

# GitHub/settings removed from sample
# Add repository tokens/configuration in your CI or local .env (do not commit secrets)
